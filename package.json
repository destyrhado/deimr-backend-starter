{
  "name": "deimr-backend-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.16.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "serve": "node dist/server.js",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage tests/**/*.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "npm run lint && npm run format:check && npm test && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.2",
    "dotenv": "^16.4.1",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.12.0",
    "morgan": "^1.10.1",
    "swagger-jsdoc": "^6.0.0",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.22",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.4",
    "@types/node": "^22.10.1",
    "@types/swagger-jsdoc": "^6.0.0",
    "eslint": "^9.35.0",
    "prettier": "^3.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.44.0"
  }
}
